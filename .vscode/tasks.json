{
  // Terminal > Run Test Task (or Cmd+Shift+P > "Tasks: Run Test Task") runs the whole Tytanic suite.
  // Typst compile errors inside tests land in the Problems panel with file:line links.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tt: run all tests",
      "type": "shell",
      "command": "tt",
      "args": ["run", "--use-system-fonts", "--no-fail-fast", "--diagnostic-format", "short"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "tytanic",
        "source": "typst",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s*\"\\/?([^\"]+)\":(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "tt: update references",
      "type": "shell",
      "command": "tt",
      "args": ["update", "--use-system-fonts", "${input:ttTest}"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      // By hand, once per clone and again when `version` of typst.toml changes (Cmd+Shift+P > "Tasks: Run Task").
      "label": "typst: link the package",
      "detail": "@preview/touying-ifba-unofficial:<version> -> this working copy (scripts/link.sh)",
      "type": "shell",
      "command": "sh",
      "args": ["scripts/link.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "readme: update from the decks",
      "detail": "README.md and docs/readme/*.png from template/ and example/ (scripts/readme.sh)",
      "type": "shell",
      "command": "sh",
      "args": ["scripts/readme.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "ttTest",
      "type": "promptString",
      "description": "Tytanic test id to re-record (e.g. elements/code)"
    }
  ]
}
